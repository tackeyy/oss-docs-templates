    "markdownlint-cli2": "^0.12.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/{{REPO_OWNER}}/{{REPO_NAME}}.git"
  },
  "keywords": [
    "oss",
    "documentation",
    "templates",
    "contributing",
    "code-of-conduct"
  ],
  "author": "tackeyy",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
