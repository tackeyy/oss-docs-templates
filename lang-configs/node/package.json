{
  "name": "{{REPO_NAME}}",
  "version": "1.0.0",
  "description": "{{PROJECT_NAME}}",
  "private": true,
  "scripts": {
    "lint": "npm run lint:md && npm run lint:sh",
    "lint:md": "markdownlint-cli2 '**/*.md' '!node_modules' '!CONTRIBUTING_GUIDE_PROPOSAL.md'",
    "lint:yaml": "yamllint .",
